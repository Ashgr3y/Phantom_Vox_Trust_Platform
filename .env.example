PHANTOM_VOX_ENVIRONMENT=development
PHANTOM_VOX_DEMO_MODE=true
PHANTOM_VOX_DATABASE_URL=sqlite:///./phantomvox.db
PHANTOM_VOX_JWT_SECRET=replace-with-a-long-random-secret
PHANTOM_VOX_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8000"]
PHANTOM_VOX_MAX_UPLOAD_MB=20
PHANTOM_VOX_RETAIN_RAW_AUDIO=false
PHANTOM_VOX_EPHEMERAL_BUFFER_SECONDS=15
PHANTOM_VOX_METADATA_RETENTION_DAYS=90
PHANTOM_VOX_SEED_DEMO_DATA=true
PHANTOM_VOX_DEMO_TICK_SECONDS=0.8
PHANTOM_VOX_REQUIRE_ML=false
# Leave frontend overrides empty: relative HTTPS API and WSS use the website origin.
VITE_API_URL=
VITE_WS_URL=
# Cloud providers supply PORT; the local default is 8000.
PORT=8000
